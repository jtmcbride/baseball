# Copy to .env and adjust. Every path/URL/limit is read through bbcore.config.Settings —
# nothing is hardcoded, which is what makes the cloud move a config change.

# --- Storage -----------------------------------------------------------------
# Root for raw/, lake/, db/, models/. Absolute or relative to repo root.
BB_DATA_ROOT=./data

# duckdb | postgres   (postgres lands in M3)
BB_WAREHOUSE_BACKEND=duckdb
BB_DUCKDB_PATH=./data/db/baseball.duckdb
# BB_POSTGRES_DSN=postgresql://baseball:baseball@localhost:5432/baseball

# --- Ingestion ---------------------------------------------------------------
# Statcast era starts 2015. Backfill is ~2-3h unattended at these limits.
BB_SEASON_START=2015

# Politeness. Savant is public but unofficial for bulk use — do not raise these
# without a reason. 0.25 rps ~= one request per 4s.
BB_SAVANT_RPS=0.25
BB_SAVANT_MAX_RETRIES=5
BB_SAVANT_TIMEOUT_S=120

# Stats API is official and tolerates more.
BB_STATSAPI_RPS=4.0

# FanGraphs / Baseball Reference rate-limit aggressively and prohibit scraping
# for redistribution. Personal use only; keep this slow.
BB_FANGRAPHS_RPS=0.2

# Re-pull this many trailing days on each nightly run. Savant revises pitch
# classifications and xwOBA after the fact, so append-only ingest goes stale.
BB_REFRESH_WINDOW_DAYS=14

# Identify the crawler honestly.
BB_USER_AGENT=baseball-analytics/0.1 (personal research; +https://github.com/local)

# --- API ---------------------------------------------------------------------
BB_API_HOST=127.0.0.1
BB_API_PORT=8000
BB_CORS_ORIGINS=http://localhost:5173
BB_LOG_LEVEL=INFO
